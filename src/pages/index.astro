---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import AppCard from '../components/AppCard.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { byOrder } from '../lib/apps';

import banner from '../assets/brand/banner.png';
import shotBookTrail from '../assets/hero/my-book-trail.png';
import shotPureMaths from '../assets/hero/al-pure-mathematics.png';

const apps = (await getCollection('apps')).sort(byOrder);
const anyPlay = apps.find((a) => a.data.playUrl)?.data.playUrl;
---

<BaseLayout
  title="CrunchCode Labs — small, sharp mobile apps"
  description="An independent mobile app studio. We build focused Android apps that respect your time, your battery and your data."
>
  <section class="hero">
    {/*
      The brand artwork is a white-background JPEG and its ground samples as
      exactly #FFFFFF, so it sits on this hero with no keying and no halo. The
      wordmark, the monospace tagline and the build/ship/iterate icons are all
      baked into it — which is why none of them are repeated in markup below.
    */}
    <span class="px" style="width:11px;height:11px;background:#8F88FF;opacity:.7;top:58px;left:7%"></span>
    <span class="px" style="width:7px;height:7px;background:#C9C4FF;top:100px;left:13%"></span>
    <span class="px" style="width:13px;height:13px;background:#6C63FF;opacity:.22;top:156px;left:4%"></span>
    <span class="px" style="width:8px;height:8px;background:#CFCBFF;top:44px;left:26%"></span>
    <span class="px" style="width:9px;height:9px;background:#B9B3FF;opacity:.8;top:66px;left:85%"></span>
    <span class="px" style="width:6px;height:6px;background:#8F88FF;opacity:.6;top:122px;left:92%"></span>
    <span class="px" style="width:14px;height:14px;background:#D6D2FF;top:184px;left:89%"></span>
    <span class="px" style="width:7px;height:7px;background:#9E97FF;opacity:.5;top:220px;left:76%"></span>

    <div class="wrap">
      <SiteHeader />
      <div class="centre">
        <h1 class="mark">
          <Image
            src={banner}
            alt="CrunchCode Labs — build · ship · iterate"
            widths={[480, 720, 1032]}
            sizes="(max-width: 700px) 88vw, 640px"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
        </h1>
        <p class="lede">Apps that feel good to use.</p>
        <p class="sub">
          An independent studio building focused mobile tools for Android. Private by default,
          free to try, and never in a hurry to sell you anything.
        </p>
        <StoreBadges playUrl={anyPlay} name="CrunchCode Labs apps" />

        <div class="devices">
          <div class="dev back">
            <Image
              src={shotPureMaths}
              alt="A/L Pure Mathematics, showing the topic list"
              widths={[220, 340]}
              sizes="150px"
              format="webp"
              loading="eager"
            />
          </div>
          <div class="dev">
            <Image
              src={shotBookTrail}
              alt="My Book Trail, showing a reading library"
              widths={[260, 400]}
              sizes="172px"
              format="webp"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="apps wrap" aria-labelledby="apps-h">
    <h2 id="apps-h">Our apps</h2>
    <div class="cards">
      {apps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  {/*
    Buy Me a Coffee floating widget, homepage only. `is:inline` stops Astro
    bundling the tag — bundling strips the data-* attributes the widget reads
    its entire configuration from, and it would load and silently do nothing.
  */}
  <script
    is:inline
    data-name="BMC-Widget"
    data-cfasync="false"
    src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
    data-id="crunchcodelabs"
    data-description="Support me on Buy me a coffee!"
    data-message="These apps are free and carry no subscription. If one of them has been useful, buying a coffee is a kind way to say so."
    data-color="#26B0A1"
    data-position="Right"
    data-x_margin="18"
    data-y_margin="18"></script>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #ffffff;
    border-bottom: 1px solid var(--line);
    padding-bottom: 44px;
  }
  .hero .wrap {
    position: relative;
    z-index: 2;
  }

  /* The pixel motif from the brand artwork, carried past the image's edges. */
  .px {
    position: absolute;
    z-index: 1;
    border-radius: 1px;
  }

  .centre {
    text-align: center;
    padding-top: 26px;
  }

  .mark {
    margin: 0 auto;
    max-width: 640px;
    line-height: 0;
  }
  .mark :global(img) {
    width: 100%;
    height: auto;
  }

  .lede {
    font-size: clamp(1.375rem, 3.4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 18px 0 0;
  }
  .sub {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: var(--ink-2);
    max-width: 46ch;
    margin: 12px auto 22px;
  }
  .centre :global(.badges) {
    justify-content: center;
  }

  .devices {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: flex-end;
    margin-top: 34px;
  }
  .dev {
    border-radius: 18px;
    background: var(--ink);
    padding: 5px;
    flex: 0 0 auto;
    width: 172px;
    box-shadow: 0 18px 44px rgba(20, 20, 19, 0.18);
  }
  .dev.back {
    width: 150px;
    transform: translateY(-22px) rotate(-5deg);
  }
  .dev :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 13px;
  }

  .apps {
    padding: 48px 0 8px;
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 20px;
  }
  .cards {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    max-width: 1120px;
  }

  @media (max-width: 640px) {
    .devices {
      gap: 12px;
      margin-top: 26px;
    }
    .dev {
      width: 138px;
    }
    .dev.back {
      width: 120px;
    }
  }
</style>
