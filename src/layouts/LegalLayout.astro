---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { appPath } from '../lib/urls';
import type { MarkdownHeading } from 'astro';

interface Props {
  appName: string;
  appSlug: string;
  title: string;
  updated: Date;
  accent: string;
  accentDeep: string;
  headings?: MarkdownHeading[];
}
const { appName, appSlug, title, updated, accent, accentDeep, headings = [] } = Astro.props;

const stamp = updated.toISOString().slice(0, 10);
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={`${title} — ${appName} — CrunchCode Labs`}
  description={`${title} for ${appName}.`}
  accent={accent}
  accentDeep={accentDeep}
>
  <div class="wrap">
    <SiteHeader />
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Apps</a> <span aria-hidden="true">/</span>
      <a href={appPath(appSlug)}>{appName}</a> <span aria-hidden="true">/</span>
      <span>{title}</span>
    </nav>

    <div class="cols">
      <article class="doc">
        <h1>{title}</h1>
        <p class="meta">
          {appName} · Last updated <time datetime={stamp}>{stamp}</time>
        </p>
        <div class="prose"><slot /></div>
      </article>

      {
        toc.length > 2 && (
          <aside class="toc" aria-labelledby="toc-h">
            <h2 id="toc-h">Contents</h2>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .crumb {
    font-size: 0.75rem;
    color: var(--ink-3);
    margin: 12px 0 28px;
  }
  .crumb a {
    color: var(--ink-2);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 48px;
    align-items: start;
  }
  .doc {
    max-width: var(--measure);
    padding-bottom: 8px;
  }
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
  }
  .meta {
    font-size: 0.8125rem;
    color: var(--ink-3);
    margin-top: 10px;
  }
  .prose {
    margin-top: 32px;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .prose :global(h2) {
    font-size: 1.125rem;
    color: var(--ink);
    margin: 32px 0 10px;
    scroll-margin-top: 16px;
  }
  .prose :global(h3) {
    font-size: 1rem;
    color: var(--ink);
    margin: 24px 0 8px;
  }
  .prose :global(p) {
    margin-bottom: 14px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 14px 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--app-accent);
    padding: 12px 16px;
    margin: 0 0 20px;
    background: var(--surface);
    border-radius: 0 8px 8px 0;
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(a) {
    color: var(--app-accent-deep);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 18px;
    font-size: 0.875rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--line);
    padding: 9px 12px;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    background: var(--rail);
    color: var(--ink);
    font-weight: 600;
  }

  .toc {
    position: sticky;
    top: 24px;
    font-size: 0.8125rem;
  }
  .toc h2 {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 12px;
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .toc a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--app-accent-deep);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .toc {
      display: none;
    }
  }
</style>
